# ====================== DeepSeek API 配置 ======================
# DeepSeek API 密钥（申请地址：https://platform.deepseek.com/）
DEEPSEEK_API_KEY=your_api_key_here
# DeepSeek API 地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名称（DeepSeek V4 Pro 对应 deepseek-chat）
DEEPSEEK_MODEL_NAME=deepseek-chat

# ====================== LangSmith 监控 ======================
# 申请地址：https://smith.langchain.com/
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=IntelliDesk

# ====================== 服务器配置 ======================
HOST=0.0.0.0
PORT=8000

# ====================== Embedding 模型 ======================
# 用于 RAG 向量化，也走 DeepSeek 接口（或可替换为 OpenAI）
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_API_KEY=your_api_key_here
EMBEDDING_BASE_URL=https://api.deepseek.com

# ====================== VLM 多模态（图片识别）======================
# 阿里百炼 API Key（申请地址：https://bailian.console.aliyun.com/）
# 不填则用硅基流动兜底（VL模型可能被禁用，建议配置此项）
VLM_API_KEY=your_vlm_api_key_here
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL_NAME=qwen-vl-max
